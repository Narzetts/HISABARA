# Hisabara - Environment Configuration
# Copy this file to .env and adjust values

# Database
DB_HOST=localhost
DB_NAME=keuangan_masjid
DB_USER=root
DB_PASS=

# AI Service (OpenRouter)
AI_API_KEY=sk-or-v1-your_key_here
AI_MODEL=deepseek/deepseek-chat

# Application
APP_NAME=Hisabara
APP_URL=http://localhost/bis
APP_ENV=development
APP_DEBUG=false

# Session
SESSION_TIMEOUT=3600
SESSION_REGENERATE=86400

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
UPLOAD_MAX_SIZE=5242880
